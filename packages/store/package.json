{
  "name": "finalstore",
  "license": "MIT",
  "version": "1.1.2",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf .turbo node_modules dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.8.9",
    "@finalstore/eslint-config": "workspace:*",
    "@finalstore/tsconfig": "workspace:*",
    "@finalstore/tsup-config": "workspace:*",
    "@types/react": "^18.2.73",
    "react": "^18.2.0",
    "tsup": "8.2.4",
    "typescript": "^4.5.2",
    "vitest": "^2.0.5",
    "@testing-library/react": "^14.3.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://store.jozefini.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jozefini/finalstore.git"
  },
  "keywords": [
    "react",
    "store"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
